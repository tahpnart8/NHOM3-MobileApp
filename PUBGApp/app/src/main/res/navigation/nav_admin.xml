<?xml version="1.0" encoding="utf-8"?>
<!-- E01 dashboard is the root; E02 and E03 are users, E04 and the listing detail are moderation. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_admin"
    app:startDestination="@id/adminDashboardFragment">

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminDashboardFragment">
        <action
            android:id="@+id/action_admin_dashboard_to_user_list"
            app:destination="@id/adminUserListFragment" />
        <action
            android:id="@+id/action_admin_dashboard_to_moderation"
            app:destination="@id/adminModerationFragment" />
        <action
            android:id="@+id/action_admin_dashboard_to_category"
            app:destination="@id/adminCategoryFragment" />
        <action
            android:id="@+id/action_admin_dashboard_to_deal_monitor"
            app:destination="@id/adminDealMonitorFragment" />
        <action
            android:id="@+id/action_admin_dashboard_to_admin_account"
            app:destination="@id/adminAccountFragment" />
        <action
            android:id="@+id/action_admin_dashboard_to_complaint_list"
            app:destination="@id/adminComplaintListFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminUserListFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminUserListFragment">
        <argument
            android:name="pendingOnly"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_admin_user_list_to_user_detail"
            app:destination="@id/adminUserDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminUserDetailFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminUserDetailFragment">
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminModerationFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminModerationFragment">
        <action
            android:id="@+id/action_admin_moderation_to_listing_detail"
            app:destination="@id/adminListingDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminListingDetailFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminListingDetailFragment">
        <argument
            android:name="listingId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminComplaintListFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminComplaintListFragment">
        <action
            android:id="@+id/action_admin_complaint_list_to_detail"
            app:destination="@id/adminComplaintDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminComplaintDetailFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminComplaintDetailFragment">
        <argument
            android:name="complaintId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminAccountFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminAccountFragment">
    </fragment>

    <fragment
        android:id="@+id/adminCategoryFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminCategoryFragment">
    </fragment>

    <fragment
        android:id="@+id/adminDealMonitorFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminDealMonitorFragment">
        <action
            android:id="@+id/action_admin_deal_monitor_to_detail"
            app:destination="@id/adminDealDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminDealDetailFragment"
        android:name="com.nhom3.pubgapp.ui.admin.AdminDealDetailFragment">
        <argument
            android:name="dealId"
            app:argType="string" />
    </fragment>
</navigation>
