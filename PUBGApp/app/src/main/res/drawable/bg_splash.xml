<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window on Android 11: app background with the official splash logo centred at a fixed size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/background" />
    <item
        android:width="@dimen/splash_logo_width"
        android:height="@dimen/splash_logo_height"
        android:drawable="@drawable/ic_logo_splash"
        android:gravity="center" />
</layer-list>
