<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Shown on the Home tab only; code toggles it in MainActivity. Light, because the logo's dark teal text
         is unreadable on the green; Home's green search row sits right below it. -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <ImageView
            android:id="@+id/imageAppLogo"
            android:layout_width="0dp"
            android:layout_height="@dimen/logo_header_height"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitStart"
            android:src="@drawable/ic_logo_header" />

        <FrameLayout
            android:id="@+id/frameNotifications"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min">

            <ImageButton
                android:id="@+id/buttonNotifications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_top_bar_notifications"
                android:src="@drawable/ic_bell"
                app:tint="?attr/colorPrimary" />

            <!-- The unread count; the button's content description already says it, so this is hidden from TalkBack. -->
            <TextView
                android:id="@+id/textNotificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="@dimen/space_md"
                android:minHeight="@dimen/space_md"
                android:paddingHorizontal="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnTertiary"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameTopBarAvatar"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@drawable/bg_avatar_ring"
            android:clickable="true"
            android:contentDescription="@string/common_top_bar_profile"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/badge_stroke">

            <include
                android:id="@+id/includeAvatar"
                layout="@layout/view_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostMain"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
