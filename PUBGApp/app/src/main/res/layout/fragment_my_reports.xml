<?xml version="1.0" encoding="utf-8"?>
<!-- D07 MyReportsFragment: two tabs, each a child layout with a stable id. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_detail_toolbar" />

    <include
        android:id="@+id/includeOfflineBanner"
        layout="@layout/view_offline_banner"
        android:visibility="gone" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutMyReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnSurfaceVariant">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_my_reports_tab_reports" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_my_reports_tab_complaints" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/includeReports"
            layout="@layout/view_my_reports_reports" />

        <include
            android:id="@+id/includeComplaints"
            layout="@layout/view_my_reports_complaints"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
