<?xml version="1.0" encoding="utf-8"?>
<!-- B06 card: the shared listing card with an unsave button and a "no longer available" state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include
        android:id="@+id/includeCard"
        layout="@layout/item_listing_card" />

    <TextView
        android:id="@+id/textUnavailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_chip"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingVertical="@dimen/space_xs"
        android:text="@string/listing_saved_unavailable_label"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonUnsave"
        style="@style/Widget.PUBGApp.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_sm"
        android:minHeight="@dimen/touch_min"
        android:text="@string/listing_saved_unsave" />
</FrameLayout>
