<?xml version="1.0" encoding="utf-8"?>
<!-- D07 tab "Khiếu nại của tôi": the list of sent complaints and its four states. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerComplaints"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressComplaints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/common_loading"
        android:visibility="gone" />

    <include
        android:id="@+id/includeComplaintsEmpty"
        layout="@layout/view_empty_state"
        android:visibility="gone" />

    <include
        android:id="@+id/includeComplaintsError"
        layout="@layout/view_error_state"
        android:visibility="gone" />
</FrameLayout>
