<?xml version="1.0" encoding="utf-8"?>
<!-- E06 AdminDealMonitorFragment: deal status filter chips, deal list with four states. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_detail_toolbar" />

    <include
        android:id="@+id/includeOfflineBanner"
        layout="@layout/view_offline_banner"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/admin_deal_monitor_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusPendingConfirm"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_status_deal_pending_confirm" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusConfirmed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_status_deal_confirmed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusShipped"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_status_deal_shipped" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusReceived"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_status_deal_received" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusCompleted"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_status_deal_completed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusCancelled"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_status_deal_cancelled" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusDisputed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_status_deal_disputed" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDeals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_md" />

        <ProgressBar
            android:id="@+id/progressDeals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <include
            android:id="@+id/includeEmptyState"
            layout="@layout/view_empty_state"
            android:visibility="gone" />

        <include
            android:id="@+id/includeErrorState"
            layout="@layout/view_error_state"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
