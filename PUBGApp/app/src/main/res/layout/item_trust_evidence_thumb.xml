<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_sm"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageThumb"
        android:layout_width="@dimen/avatar_size_lg"
        android:layout_height="@dimen/avatar_size_lg"
        android:background="?attr/colorOutline"
        android:contentDescription="@string/profile_report_evidence_thumb"
        android:scaleType="centerCrop" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRemoveImage"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:text="@string/profile_report_evidence_remove" />
</LinearLayout>
