<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp"
    android:layout_height="88dp"
    android:layout_marginEnd="@dimen/space_sm"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="@dimen/elevation_card">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/listing_post_image_preview_desc"
            android:scaleType="centerCrop" />

        <ImageButton
            android:id="@+id/buttonRemoveImage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_xs"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@string/listing_post_remove_image"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?attr/colorOnPrimary" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
