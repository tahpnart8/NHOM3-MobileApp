<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing scale, multiples of 4. Do not use values outside it. -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>

    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">24dp</dimen>

    <dimen name="elevation_card">2dp</dimen>

    <!-- Smallest side of anything tappable. -->
    <dimen name="touch_min">48dp</dimen>

    <!-- Cover height of item_listing_card; the width follows the column. -->
    <dimen name="listing_card_image_height">144dp</dimen>

    <!-- Circle behind the icon of view_empty_state and view_error_state. -->
    <dimen name="state_icon_circle">96dp</dimen>

    <!-- White edge of the count badge and of the avatar ring on the green header. -->
    <dimen name="badge_stroke">2dp</dimen>

    <!-- Shortcut tiles of the admin dashboard (E01). -->
    <dimen name="tile_min_height">72dp</dimen>

    <!-- Large avatar, for profile headers (view_avatar defaults to touch_min). -->
    <dimen name="avatar_size_lg">96dp</dimen>

    <!-- Largest side of the sample transfer QR on the C07 gateway, so it stays a QR size in landscape. -->
    <dimen name="qr_max_size">240dp</dimen>
</resources>
