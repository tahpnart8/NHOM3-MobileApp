#!/bin/sh
# Keep machine specific files, secrets and a damaged decision ledger out of a commit.
here=$(cd "$(dirname "$0")/.." && pwd)

sh "$here/scripts/check-decisions.sh" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

blocked=$(printf '%s\n' "$staged" | grep -E '(^|/)(local\.properties|\.env(\..*)?)$|\.(jks|keystore|p12|pem)$' | grep -v '^$' || true)
if [ -n "$blocked" ]; then
    echo "pre-commit: refused. These files hold secrets or machine specific settings and must not be committed:" >&2
    printf '  %s\n' $blocked >&2
    exit 1
fi

for f in $staged; do
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt 5242880 ]; then
        echo "pre-commit: refused. $f is larger than 5 MB. Ask the leader before adding large files." >&2
        exit 1
    fi
done

if git diff --cached -U0 | grep -Eq '^\+(<<<<<<< |>>>>>>> )'; then
    echo "pre-commit: refused. A merge conflict marker is staged." >&2
    exit 1
fi
exit 0
