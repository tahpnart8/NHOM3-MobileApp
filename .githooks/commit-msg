#!/bin/sh
# Refuse a commit whose identity or message would put an AI tool or a co-author on the contributor list.
# Install once per clone: sh workflow/scripts/setup-dev.sh   (or workflow/scripts/setup-dev.ps1 on Windows)
here=$(cd "$(dirname "$0")/.." && pwd)
sh "$here/workflow/scripts/check-contributors.sh" identity || exit 1
sh "$here/workflow/scripts/check-contributors.sh" message "$1" || exit 1
